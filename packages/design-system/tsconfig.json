{
  "extends": "../config/tsconfig.package.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2017",
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src/**/*", "src/stories/**/*", "custom.d.ts"],
  "exclude": ["node_modules", "dist", "./src/**/*.stories.*"],
  "build": {
    "outDir": "storybook-static",
    "emptyOutDir": true
  }
}
